# Portable Slack credentials. Do not set these together with SLACK_CONNECTOR.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Vercel Connect Slack connector UID. Preferred on Vercel. Omit to use the portable tokens.
SLACK_CONNECTOR=

# Fine-grained GitHub PAT used by authored tools (contents + pull requests; never merge).
# Alternatively set GITHUB_CONNECTOR to a Vercel Connect GitHub App connector UID.
GITHUB_TOKEN=
GITHUB_CONNECTOR=

# owner/repo the tools read and write. Defaults to this repository.
GITHUB_REPOSITORY=Awannaphasch2016/wewebplus-software-factory

# Optional model override. Default is anthropic/claude-opus-5.5.
SPECIFICATION_AGENT_MODEL=
ARCHITECTURE_AGENT_MODEL=

# Present automatically on Vercel for Sandbox and AI Gateway. Do not commit values.
# VERCEL_OIDC_TOKEN
# VERCEL_TEAM_ID
# VERCEL_PROJECT_ID
