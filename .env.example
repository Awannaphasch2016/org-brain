# Portable Slack credentials. Do not set these together with SLACK_CONNECTOR.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Vercel Connect Slack connector UID. Preferred on Vercel. Omit to use the portable tokens.
SLACK_CONNECTOR=

# Preferred GitHub identity: our GitHub App. Set all three, or none of them.
# GITHUB_APP_PRIVATE_KEY is a PEM. Do not commit a real key.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Personal-token fallback. It stays until the GitHub App is verified.
# Set FACTORY_REQUIRE_APP=1 to refuse this fallback.
GITHUB_TOKEN=
FACTORY_REQUIRE_APP=

# Optional GitHub App via Vercel Connect. Used only when the app env above is unset.
GITHUB_CONNECTOR=

# Gate approvers. Comma-separated human Slack user ids (U…).
# Unset uses U0CFRUV378D. The owner must verify that id is Anak's current Slack user.
# An empty or invalid list allows nobody, not everyone.
FACTORY_GATE_APPROVER_IDS=
FACTORY_GATE_DENY_SLACK_IDS=

# Exact GitHub check name required before merge. Unset pins "check".
FACTORY_REQUIRED_CHECK=

# Required owner/repo. The code does not guess. This repository is Awannaphasch2016/org-brain.
GITHUB_REPOSITORY=Awannaphasch2016/org-brain

# Optional model override. Default is anthropic/claude-opus-5.5.
SPECIFICATION_AGENT_MODEL=
ARCHITECTURE_AGENT_MODEL=
PLANNING_AGENT_MODEL=
IMPLEMENTATION_AGENT_MODEL=
CHANGE_CONTROL_AGENT_MODEL=
RELEASE_AGENT_MODEL=

# Present automatically on Vercel for Sandbox and AI Gateway. Do not commit values.
# VERCEL_OIDC_TOKEN
# VERCEL_TEAM_ID
# VERCEL_PROJECT_ID
